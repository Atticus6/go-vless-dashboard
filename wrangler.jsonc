{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "go-vless-dashboard",
  // Set this to today's date
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "go-vless-dashboard",
      "database_id": "1ed9f4a3-e394-4cf1-88ad-20ac1a18da6e",
      "migrations_dir": "d1/migrations",
      "remote": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "placement":{
    "mode": "smart"
  },
  "preview_urls": true,
  // 订阅接口限流：每个客户端 IP 每 60 秒最多 10 次（按 Cloudflare 边缘位置分别计数）。
  // namespace_id 在同一账号内全局唯一，换新绑定务必换号，避免与其它限流器共用计数。
  "ratelimits": [
    {
      "name": "SUB_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}